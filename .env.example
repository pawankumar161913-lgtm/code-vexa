# ---------------------------------------------------------------------------
# AI Bug Detective — environment configuration (SERVER SIDE ONLY)
# Copy this file to `.env` for local development with `netlify dev`.
# NEVER prefix any of these with VITE_ — VITE_* variables are inlined into the
# public browser bundle and would leak your key to every visitor.
# ---------------------------------------------------------------------------

# --- AI provider ------------------------------------------------------------
# Which provider adapter the backend uses: "openai" | "anthropic" | "custom"
# "custom" means any OpenAI-compatible chat-completions endpoint (Groq, Together,
# OpenRouter, Ollama, Azure OpenAI gateway, ...). Set AI_BASE_URL for it.
AI_PROVIDER=openai

# Your secret API key. Keep this out of git (`.env` is already gitignored).
AI_API_KEY=your_api_key_here

# Model name. Examples:
#   openai      -> gpt-4o-mini
#   anthropic   -> claude-3-5-sonnet-latest
#   custom      -> llama-3.3-70b-versatile
AI_MODEL=gpt-4o-mini

# Only for AI_PROVIDER=custom: OpenAI-compatible base URL, without the
# trailing /chat/completions, e.g. https://api.groq.com/openai/v1
AI_BASE_URL=

# Optional hard timeout for the upstream AI call, in milliseconds.
AI_TIMEOUT_MS=45000

# --- Request limits ---------------------------------------------------------
# Per-IP sliding window (in-memory, per function instance). For durable,
# cross-instance limits put Netlify/Cloudflare rate limiting in front of /api/*.
RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW_MS=60000
MAX_BODY_BYTES=200000
MAX_CODE_CHARS=40000

# --- CORS (comma separated origins) ----------------------------------------
# Leave empty to allow only same-origin requests.
ALLOWED_ORIGINS=

# --- Frontend (safe to be public) ------------------------------------------
VITE_SITE_URL=https://ai-bug-detective.netlify.app
