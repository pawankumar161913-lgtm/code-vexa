# ---------------------------------------------------------------------------
# Code Vexa — environment configuration (SERVER SIDE ONLY)
# Copy this file to `.env` for local development with `netlify dev`.
# NEVER prefix any of these with VITE_ — VITE_* variables are inlined into the
# public browser bundle and would leak your key to every visitor.
# ---------------------------------------------------------------------------

# --- AI provider ------------------------------------------------------------
# Free-key presets: "groq" | "gemini" | "openrouter" | "cerebras" | "ollama"
# Paid / self-managed: "openai" | "anthropic" | "custom"
# "custom" means any OpenAI-compatible chat-completions endpoint; set AI_BASE_URL.
#
#   groq        free key: https://console.groq.com/keys
#   gemini      free key: https://aistudio.google.com/apikey
#   openrouter  free key: https://openrouter.ai/keys  (use a ":free" model)
#   cerebras    free key: https://cloud.cerebras.ai/
#   ollama      local model, no key needed (AI_BASE_URL defaults to localhost)
AI_PROVIDER=groq

# Your secret API key. Keep this out of git (`.env` is already gitignored).
# Not needed for AI_PROVIDER=ollama.
AI_API_KEY=your_api_key_here

# Optional: overrides the preset's default model.
#   groq        -> llama-3.3-70b-versatile
#   gemini      -> gemini-flash-lite-latest
#   openrouter  -> meta-llama/llama-3.3-70b-instruct:free
#   cerebras    -> llama-3.3-70b
#   openai      -> gpt-4o-mini
#   anthropic   -> claude-3-5-sonnet-latest
AI_MODEL=

# Optional: override the base URL (custom provider, or a proxy/self-hosted
# gateway). Without the trailing /chat/completions.
AI_BASE_URL=

# Optional hard timeout for the upstream AI call, in milliseconds.
AI_TIMEOUT_MS=45000

# --- Request limits ---------------------------------------------------------
# Per-IP sliding window (in-memory, per function instance). For durable,
# cross-instance limits put Netlify/Cloudflare rate limiting in front of /api/*.
RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW_MS=60000
MAX_BODY_BYTES=200000
MAX_CODE_CHARS=40000

# --- CORS (comma separated origins) ----------------------------------------
# Leave empty to allow only same-origin requests.
ALLOWED_ORIGINS=

# --- Frontend (safe to be public) ------------------------------------------
VITE_SITE_URL=https://code-vexa.netlify.app
